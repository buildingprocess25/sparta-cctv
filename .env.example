# =============================================
# DATABASE (PostgreSQL)
# =============================================
# Contoh: postgresql://USER:PASSWORD@localhost:5432/sparta_cctv
DATABASE_URL=
# Dipakai Prisma untuk migrasi (sama dengan DATABASE_URL jika tidak memakai pooler)
DIRECT_URL=

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# =============================================
# APLIKASI
# =============================================
TZ=Asia/Jakarta
NEXT_PUBLIC_APP_URL=http://localhost:3002
APP_BASE_URL=http://localhost:3002

# Sumber data dashboard:
#   mock  = data contoh bawaan, tanpa database
#   db    = PostgreSQL (hasil seed / data nyata)
#   ezviz = PostgreSQL + status/snapshot/live dari EZVIZ Open API (menyusul)
CAMERA_DATA_SOURCE=mock
# (opsional, mode mock) simulasi akun EZVIZ kontraktor bermasalah, indeks 0-7 dipisah koma. Contoh: 1,3
# MOCK_BROKEN_ACCOUNT=

# Halaman admin akun EZVIZ (/pengaturan/ezviz) menyimpan kredensial kontraktor dan belum punya login.
# Biarkan false; aktifkan (true) hanya di lingkungan yang sudah dilindungi basic auth / IP kantor.
ADMIN_UI_ENABLED=false

# Rahasia untuk endpoint cron (dipanggil crontab di VPS lewat header Authorization: Bearer ...).
# Buat: openssl rand -base64 32
CRON_SECRET=

# =============================================
# EZVIZ OPEN PLATFORM
# =============================================
# appKey/appSecret TIDAK diisi di sini: tiap kontraktor punya akun sendiri,
# kredensialnya dimasukkan lewat halaman admin dan disimpan terenkripsi di database.

# Kunci enkripsi untuk appSecret & accessToken di database (32 byte, base64).
# Buat: openssl rand -base64 32
# PENTING: simpan cadangannya di tempat aman. Jika hilang, semua kredensial EZVIZ di
# database tidak bisa dibaca dan harus dimasukkan ulang.
EZVIZ_ENCRYPTION_KEY=

# Host untuk meminta token (token/get). Panggilan lain memakai areaDomain dari respons token.
EZVIZ_TOKEN_BASE_URL=https://open.ezvizlife.com

# Folder penyimpanan snapshot kamera
SNAPSHOT_DIR=./storage/snapshots

# (opsional) Pengaturan poller status kamera — nilai bawaan ditampilkan
# POLL_UNSTABLE_THRESHOLD=3      # putus hari ini yang membuat kamera online dianggap tidak stabil
# POLL_SD_INTERVAL_MIN=30        # jeda minimum cek MicroSD per kamera
# POLL_SNAPSHOT_INTERVAL_MIN=15  # jeda minimum snapshot per kamera (memakai data 4G kamera)
# POLL_CONCURRENCY=3             # jumlah akun EZVIZ yang dicek bersamaan

# Cara memutar live: "ezopen" (bawaan, player resmi EZVIZ di browser; wajib untuk kamera baterai/4G
# seperti EB8 — HLS standar hanya menghasilkan ErrCode) atau "hls" (proxy server, token tidak ke browser).
LIVE_PROTOCOL=ezopen

# Jumlah live/playback bersamaan per akun EZVIZ (paket Free = 1 Mbps per akun; sub-stream ±300–500 kbps).
# Dipakai juga oleh halaman live semua kamera kontraktor. Naikkan ke 3 hanya bila sudah diuji stabil.
# LIVE_MAX_SESSIONS_PER_ACCOUNT=2
